@using CSC449_SeatReservationSystem.Entity
@model ICollection<Seat>;

@{

}

<table class="table text-center">
    <thead>
        <tr>
            <th>Row</th>
            <th>Seat Number</th>
            <th>Type</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach(var seat in Model)
        {
            <tr>
                <td>@Html.DisplayFor(m => seat.Row)</td>
                <td>@Html.DisplayFor(m => seat.SeatNumber)</td>
                <td>@Html.DisplayFor(m => seat.SeatType)</td>
                <td>
                    <a asp-controller="Seat" 
                    asp-action="Details" 
                    asp-route-id="@seat.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>