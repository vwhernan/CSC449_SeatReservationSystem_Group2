@using CSC449_SeatReservationSystem.Entity
@model ICollection<Showtime>


<table class="table text-center">
    <thead>
        <tr>
            <th>Movie</th>
            <th>Start</th>
            <th>End</th>
            <th>Price</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var showtime in Model)
        {
            <tr>
                <td>@showtime.Movie.Name</td>
                <td>@Html.DisplayFor(m => showtime.StartTime)</td>
                <td>@Html.DisplayFor(m => showtime.EndTime)</td>
                <td>@Html.DisplayFor(m => showtime.TicketPrice)</td>
                <td>
                    <a asp-controller="Showtime"
                       asp-action="Details"
                       asp-route-id="@showtime.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>