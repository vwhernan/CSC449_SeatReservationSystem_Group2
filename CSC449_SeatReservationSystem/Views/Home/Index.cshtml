@using CSC449_SeatReservationSystem.Entity
@model ICollection<MovieTheater>

@{
    ViewData["Title"] = "Home Page";
}

@if(Model.Count <= 0)
{
    <span>No Theaters Added</span>

}
<table class="table text-center">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Reserve Tickets</th>
        </tr>
    </thead>

    <tbody>
        @foreach(var theater in Model)
        {
            <tr>
                <td>@Html.DisplayFor(m=> theater.Name)</td>
                <td>@Html.DisplayFor(m=> theater.Address)</td>
                <td><a class="btn btn-sm btn-primary"
                   asp-action="#">
                    Buy Tickets</a></td>
            </tr>
        }
    </tbody>
</table>