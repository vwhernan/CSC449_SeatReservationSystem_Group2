@using CSC449_SeatReservationSystem.Entity
@model Movie
@{
    ViewData["Title"] = "Movie Details";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Movie Details</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Movies</a>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Overview</h5>
                    <div class="d-flex gap-2">
                        <edit-button asp-route-movieId="@Model.Id" class="btn btn-warning"></edit-button>
                        <delete-button asp-route-movieId="@Model.Id" class="btn btn-danger"></delete-button>
                    </div>
                </div>
                <div class="card-body">
                    <partial name="_View.Movie" model="Model" />
                </div>
            </div>
        </div>
    </div>
</div>