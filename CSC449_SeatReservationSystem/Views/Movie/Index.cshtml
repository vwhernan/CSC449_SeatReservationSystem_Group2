@using CSC449_SeatReservationSystem.Entity
@model IReadOnlyCollection<Movie>
@{
    ViewData["Title"] = "Movies";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Movies</h1>
    <a class="btn btn-primary" asp-action="Create" asp-controller="Movie">Add A Movie</a>
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-hover table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Rating</th>
                <th>Runtime</th>
                <th>Genre</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td class="fw-semibold">@movie.Name</td>
                    <td>@movie.Rating</td>
                    <td>@movie.MovieLengthMinutes min</td>
                    <td>@movie.Genres</td>
                    <td><a asp-action="Details" asp-route-movieId="@movie.Id">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="p-3 text-muted text-center">No movies have been added yet.</div>
}
