@using CSC449_SeatReservationSystem.Entity
@using static CSC449_SeatReservationSystem.Entity.Movie
@model MovieModel

@{
    int? movieId = ViewBag.MovieId as int?;
    var ratings = Html.GetEnumSelectList<Ratings>();
}

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="card p-4 shadow-sm">
        <div class="mb-3">
            @Html.LabelFor(m => m.Name, new { @class = "form-label fw-bold" })
            @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
        </div>
        
        <div class="col mb-3">
            @Html.LabelFor(m => m.Rating, new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.Rating, ratings, new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger small" })
        </div>
        
        <div class="mb-3">
            @Html.LabelFor(m => m.Genres, new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.Genres, Html.GetEnumSelectList<Genres>(), new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Genres, "", new { @class = "text-danger small" })
        </div>
        
        <div class="col mb-3">
            @Html.LabelFor(m => m.MovieLengthMinutes, new { @class = "form-label fw-bold" })
            @Html.EditorFor(m => m.MovieLengthMinutes, new { htmlAttributes = new { @class = "form-control", min = 1 } })
            @Html.ValidationMessageFor(m => m.MovieLengthMinutes, "", new { @class = "text-danger small" })
        </div>
        
        <div class="mt-4">
            <button-row>
                <submit-button></submit-button>
                @if (movieId.HasValue)
                {
                    <cancel-button asp-action="Details" asp-controller="Movie" asp-route-movieId="@movieId"></cancel-button>
                }
                else
                {
                    <cancel-button asp-action="Index" asp-controller="Movie"></cancel-button>
                }
            </button-row>
        </div>
    </div>
}