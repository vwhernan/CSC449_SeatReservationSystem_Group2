@using CSC449_SeatReservationSystem.Entity;
@model MovieTheater
@{
    ViewData["Title"] = "Theater Details";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@($"{Model.Name} - Details")</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Theaters</a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Overview</h5>
                    <div class="d-flex gap-2">
                        <edit-button asp-route-theaterId="@Model.TheaterId" class="btn btn-warning"></edit-button>
                        <delete-button asp-route-theaterId="@Model.TheaterId" class="btn btn-danger"></delete-button>
                    </div>
                </div>
                <div class="card-body">
                    <partial name="_View.MovieTheater" model="Model" />
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Auditoriums</h5>
                    <a class="btn btn-success"
                       asp-action="Create"
                       asp-controller="Auditorium"
                       asp-route-theaterId="@Model.TheaterId">
                        <i class="bi bi-plus-lg"></i> Add New
                    </a>
                </div>
                <div class="card-body p-0">
                    <partial name="_View.Auditoriums" model="@Model.Auditoriums" />
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Now Playing</h5>
                    <a class="btn btn-success"
                       asp-action="ManageMovies"
                       asp-controller="MovieTheater"
                       asp-route-theaterId="@Model.TheaterId">
                        <i class="bi bi-plus-lg"></i> Manage
                    </a>
                </div>
                <div class="card-body p-0">
                    <partial name="_View.NowPlaying" model="@Model.NowPlaying" />
                </div>
            </div>
        </div>



    </div>
</div>

