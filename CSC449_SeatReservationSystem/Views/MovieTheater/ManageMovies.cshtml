@model CSC449_SeatReservationSystem.Models.AddMovieToTheaterViewModel

@{
    ViewData["Title"] = "Manage Now Playing Movies";
}

<div class="container my-4">
    <h2>Manage Now Playing Movies for @Model.TheaterName</h2>
    <hr />

    <form asp-action="ManageMovies" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="TheaterId" />
        <input type="hidden" asp-for="TheaterName" />

        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 80px;" class="text-center">Select</th>
                    <th>Movie Title</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Movies.Count; i++)
                {
                    <tr>
                        <td class="text-center">
                            <input type="hidden" asp-for="Movies[i].MovieId" />
                            <input type="hidden" asp-for="Movies[i].Name" />
                            <input class="form-check-input border-secondary border-2"
                                   style="cursor: pointer; width: 1.25em; height: 1.25em;"
                                   type="checkbox"
                                   asp-for="Movies[i].IsSelected" />
                        </td>
                        <td>
                            @Model.Movies[i].Name
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Details" asp-route-theaterId="@Model.TheaterId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}