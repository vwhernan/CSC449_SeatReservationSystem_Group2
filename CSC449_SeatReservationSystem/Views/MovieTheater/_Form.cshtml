@using static CSC449_SeatReservationSystem.Entity.MovieTheater
@model MovieTheaterModel
@{
    int? theaterId = ViewBag.theaterId as int?;
}

@using (Html.BeginForm())
{
    <div class="card p-4 shadow-sm">
        <div class="mb-3">
            @Html.LabelFor(m => m.Name, new { @class = "form-label fw-bold" })
            @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
        </div>

        <h5 class="mt-3">Address</h5>
        @Html.EditorFor(m => m.Address)

        <div class="mt-4">
            <button-row>
                <submit-button></submit-button>
                @if (theaterId.HasValue)
                {
                    <cancel-button asp-route-theaterId="@theaterId"></cancel-button>
                }
                else
                {
                    <cancel-button asp-action="Index" asp-controller="MovieTheater"></cancel-button>
                }
            </button-row>
        </div>
    </div>
}