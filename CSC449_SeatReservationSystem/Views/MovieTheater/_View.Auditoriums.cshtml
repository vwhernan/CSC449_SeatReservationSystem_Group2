@using CSC449_SeatReservationSystem.Entity
@model IReadOnlyCollection<Auditorium>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var auditorium in Model)
                {
                    <tr>
                        <td class="fw-semibold">@auditorium.Name</td>
                        <td> 
                            <a asp-action="Details"
                               asp-controller="Auditorium"
                               asp-route-id="@auditorium.Id">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="p-3 text-muted text-center">
        No auditoriums available for this theater.
    </div>
}