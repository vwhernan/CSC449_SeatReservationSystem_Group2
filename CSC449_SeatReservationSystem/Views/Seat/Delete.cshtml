@using CSC449_SeatReservationSystem.Entity
@model Seat
@{
    ViewData["Title"] = "Delete Seat";
}

<h3>Delete Seat</h3>
<partial name="_View.Seat" model="Model" />

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.AuditoriumId)
    <alert alert-heading="Are you sure?" ui-style="warning">
        Are you sure you want to delete this seat? This action cannot be undone.
    </alert>
    <button-row>
        <yes-button></yes-button>
        <no-button asp-action="Details" asp-route-id="@Model.Id"></no-button>
    </button-row>
}