@using CSC449_SeatReservationSystem.Entity
@model Showtime
@{
    ViewData["Title"] = "Showtime Details";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Showtime Details</h2>
        <a asp-controller="Auditorium" asp-action="Details" asp-route-id="@Model.AuditoriumId" class="btn btn-outline-secondary btn-sm">
            Back to Auditorium
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Overview</h5>
                    <div class="d-flex gap-2">
                        <a asp-controller="Showtime" asp-action="Edit" asp-route-showtimeId="@Model.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-controller="Showtime" asp-action="Delete" asp-route-showtimeId="@Model.Id" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
                <div class="card-body">
                    <partial name="_View.Showtime" model="Model" />
                </div>
            </div>
        </div>
    </div>
</div>